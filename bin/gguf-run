#!/usr/bin/env node

const { program } = require('commander');
const chalk = require('chalk');
const inquirer = require('inquirer');
const path = require('path');
const { scanModels, scanGGUFFiles } = require('../src/scanner');
const { buildPromptQuestions } = require('../src/prompts');
const { buildLlamaCommand } = require('../src/builder');
const { runLlama } = require('../src/runner');
const { getPackageMmprojFiles } = require('../src/mmproj-matcher');

// CLI 参数定义
program
  .name('gguf-run')
  .description('Interactive CLI tool to run GGUF models with llama')
  .option('-m, --model <file>', 'GGUF model file')
  .option('-j, --mmproj <file>', 'Multimodal projection file (.gguf)')
  .option('-c, --ctx-size <size>', 'Context size', '32768')
  .option('-H, --host <host>', 'Server host', '127.0.0.1')
  .option('-p, --port <port>', 'Server port', '8080')
  .option('-T, --temp <temp>', 'Temperature', '1.0')
  .option('-P, --top-p <top-p>', 'Top-P sampling', '0.95')
  .option('-l, --llama-command <command>', 'Llama command name', 'llama-server')
  .option('-e, --extra-args <args>', 'Additional llama arguments (e.g., "--n-gpu-layers 35 --threads 4")')
  .option('--enable-thinking', 'Enable thinking mode (default: true)')
  .option('-t, --threads <count>', 'Number of threads to use during computation (default: "1")')
  .option('--gpu-layers-mode <mode>', 'GPU layers mode: auto, calculated, manual', 'auto')
  .option('--gpu-layers <count>', 'Number of GPU layers (for manual mode)', '99')
  .version('1.0.0')
  .action(async (options) => {
    try {
      await runInteractive(options);
    } catch (error) {
      console.error(chalk.red(`Error: ${error.message}`));
      process.exit(1);
    }
  });

/**
 * 获取 models 目录路径（带 fallback）
 */
function resolveModelsDir() {
  // 优先使用当前工作目录的 models
  const cwdModels = path.join(process.cwd(), 'models');
  try {
    const entries = require('fs').readdirSync(cwdModels);
    if (entries.some(e => e.endsWith('.gguf') || require('fs').statSync(path.join(cwdModels, e)).isDirectory())) {
      return cwdModels;
    }
  } catch { /* not available */ }

  // fallback: 包安装目录
  const pkgModels = path.resolve(__dirname, '..', 'models');
  try {
    require('fs').readdirSync(pkgModels);
    return pkgModels;
  } catch { /* not available */ }

  return cwdModels; // 默认返回 cwd
}

// 主交互流程
async function runInteractive(options) {
  console.log(chalk.bold.cyan('\n🦙 GGUF Model Runner\n'));

  // 1. 扫描 GGUF 文件（支持包目录和平铺模式）
  const modelsDir = resolveModelsDir();

  let scanResult = { entries: [], modelMap: {} };

  if (!options.model) {
    try {
      scanResult = scanModels(modelsDir);

      if (scanResult.entries.length === 0) {
        throw new Error('No GGUF files found in models/ directory. Please ensure you have .gguf files in the models/ directory.');
      }

      if (scanResult.hasPackages) {
        console.log(chalk.dim(`📁 ${scanResult.packageNames.length} model package(s) detected`));
      }
    } catch (error) {
      if (error.message.includes('no such file or directory') || error.code === 'ENOENT') {
        throw new Error('No "models" directory found or no GGUF files in models/. Please create a "models" directory and put your .gguf files there.');
      }
      throw error;
    }
  }

  // 2. 交互式配置
  const questions = buildPromptQuestions(options, scanResult.entries, modelsDir);
  const answers = await inquirer.prompt(questions);

  // 3. 解析模型路径
  const modelPath = options.model
    ? path.resolve(options.model)           // 命令行指定的路径
    : answers.model;                         // 交互式路径（已是绝对路径）

  // 获取模型信息（用于包内 mmproj / profile 自动发现）
  const modelInfo = scanResult.modelMap[modelPath] || null;

  // 4. 解析 mmproj 路径
  let mmprojPath = null;

  if (options.mmproj) {
    // 命令行指定的 mmproj
    mmprojPath = path.resolve(options.mmproj);
  } else {
    // 包模型：如果包内只有 1 个 mmproj，自动使用（无需用户选择）
    if (modelInfo && modelInfo.type === 'package' && modelInfo.mmprojFiles.length === 1) {
      const pkgMmproj = modelInfo.mmprojFiles[0];
      mmprojPath = path.resolve(modelInfo.packageDir, pkgMmproj);
      console.log(chalk.green(`  📦 Auto-detected mmproj: ${chalk.bold(pkgMmproj)} (from package)`));
    }
    // 用户选择了 mmproj
    else if (answers.mmproj && answers.mmproj !== 'None') {
      // 检查是否是包内 mmproj
      const modelDir = path.dirname(modelPath);
      const localMmprojs = getPackageMmprojFiles(modelPath);
      if (localMmprojs.includes(answers.mmproj)) {
        mmprojPath = path.resolve(modelDir, answers.mmproj);
      } else {
        // 全局 mmprojs 目录
        const mmprojsDir = path.join(path.dirname(modelsDir), 'mmprojs');
        mmprojPath = path.resolve(mmprojsDir, answers.mmproj);
      }
    }
  }

  const config = {
    model: modelPath,
    mmproj: mmprojPath,
    ctxSize: answers.ctxSize === '__custom__' ? answers.ctxSizeCustom : answers.ctxSize,
    host: answers.host,
    port: answers.port,
    temp: answers.temp,
    topP: answers.topP,
    gpuLayersMode: answers.gpuLayersMode,
    gpuLayers: answers.gpuLayers,
    extraArgs: answers.extraArgs,
    llamaCommand: answers.llamaCommand,
    enableThinking: options.enableThinking ?? answers.enableThinking,
    threads: options.threads || answers.threads
  };

  // 5. 显示完整命令并确认
  const { command, gpuInfo } = await buildLlamaCommand(config);

  console.log(chalk.dim('\n📝 Command to execute:'));
  if (gpuInfo) {
    console.log(chalk.cyan(`   ${gpuInfo}`));
  }
  console.log(chalk.green(command));

  const { confirmRun } = await inquirer.prompt([
    {
      type: 'confirm',
      name: 'confirmRun',
      message: 'Run this command?',
      default: true
    }
  ]);

  if (!confirmRun) {
    console.log(chalk.yellow('Cancelled.'));
    return;
  }

  // 6. 执行命令
  console.log(chalk.dim('\n🚀 Starting llama...\n'));
  await runLlama(config);
}

program.parse();
